# paired-cot-image plus the GLiNER library, for eval_baselines.py. A separate
# image, so that the image of the main experiment is never changed under it.
# gliner 0.2.29 accepts the image's transformers (>=4.51.3, <5.17); pinning
# transformers keeps pip from moving it.
#
# Build on the node, from the repository root (after paired-cot-image):
#   docker build -f 05_openvocab_sft/build_paired/Dockerfile.baselines -t paired-baselines-image .
FROM paired-cot-image
RUN pip install --no-cache-dir "gliner==0.2.29" "transformers==4.56.2"
